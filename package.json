{
  "name": "soosisgame",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build -w web",
    "test": "npm run test -w shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
