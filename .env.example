# توکن ربات از @BotFather (هرگز کامیت نکنید)
BOT_TOKEN=

# آدرس مینی‌اپ (GitHub Pages). اگر خالی بماند برای لوکال http://localhost:5173/SoosisGame/
WEBAPP_URL=

# پورت سرور بازی (HTTP + WebSocket)
PORT=8787

# شناسه عددی شما در تلگرام برای پیام «آنلاین شدم»
TG_OWNER_ID=

# در توسعهٔ محلی بدون تلگرام: 1 (auth با نام ساده + ساخت بازی با POST /dev/games)
ALLOW_DEV=1

# امتیاز لازم برای برد نهایی مسابقه
MATCH_TARGET=7
